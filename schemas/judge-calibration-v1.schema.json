{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplexidev.github.io/codex-toolkit-metrics/schemas/judge-calibration-v1.schema.json",
  "title": "Bounded JEV and GPT judge calibration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gptJudge", "examples"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "gptJudge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "reasoning", "version"],
      "properties": {
        "provider": { "const": "openai" },
        "model": { "type": "string", "minLength": 1 },
        "reasoning": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "executable": { "type": "string", "minLength": 1 }
      }
    },
    "jev": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apiUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "model": { "type": "string", "minLength": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 120 },
        "maxInputBytes": { "type": "integer", "minimum": 256, "maximum": 65536 },
        "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "passScore": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rubric", "response", "expectedPass"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "rubric": { "type": "string", "minLength": 1 },
          "response": { "type": "string", "minLength": 1 },
          "expectedPass": { "type": "boolean" }
        }
      }
    }
  }
}
