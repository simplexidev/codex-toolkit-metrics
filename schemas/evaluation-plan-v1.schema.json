{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplexidev.github.io/codex-toolkit-metrics/schemas/evaluation-plan-v1.schema.json",
  "title": "Codex Toolkit evaluation runner plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suite", "fixtureRoot", "repetitions", "timeoutSeconds", "executor", "judge", "provenance", "arms", "scenarios"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "suite": { "$ref": "#/$defs/name" },
    "fixtureRoot": { "$ref": "#/$defs/name" },
    "repetitions": { "type": "integer", "minimum": 1 },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "executor": { "$ref": "#/$defs/provider" },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "enum": ["deterministic", "jev", "gpt"] },
        "provider": { "type": "string" },
        "model": { "$ref": "#/$defs/name" }
      },
      "allOf": [
        {
          "if": { "properties": { "path": { "const": "gpt" } }, "required": ["path"] },
          "then": { "required": ["provider", "model"], "properties": { "provider": { "const": "openai" } } },
          "else": { "not": { "anyOf": [{ "required": ["provider"] }, { "required": ["model"] }] } }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolkit", "metrics"],
      "properties": {
        "toolkit": { "$ref": "#/$defs/revision" },
        "metrics": { "$ref": "#/$defs/revision" },
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sha": { "type": ["string", "null"] },
            "path": { "type": ["string", "null"] }
          }
        }
      }
    },
    "arms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "comparison", "customization"],
        "properties": {
          "id": { "$ref": "#/$defs/name" },
          "comparison": { "enum": ["VANILLA", "UPSTREAM", "OPTIMIZED"] },
          "customization": { "enum": ["BUILTIN-or-NO-CUSTOM", "PREVIOUS-CUSTOM", "OPTIMIZED-or-NEW"] },
          "skillPaths": { "$ref": "#/$defs/paths" },
          "agentPaths": { "$ref": "#/$defs/paths" }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability", "expected"],
        "properties": {
          "id": { "$ref": "#/$defs/name" },
          "capability": { "$ref": "#/$defs/name" },
          "prompt": { "$ref": "#/$defs/name" },
          "promptFile": { "$ref": "#/$defs/name" },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "exitCode": { "type": "integer" },
              "outputKind": { "enum": ["any", "text", "json"] },
              "responseContains": { "$ref": "#/$defs/paths" },
              "filesExist": { "$ref": "#/$defs/paths" },
              "fileContains": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "contains"],
                  "properties": {
                    "path": { "$ref": "#/$defs/name" },
                    "contains": { "$ref": "#/$defs/name" }
                  }
                }
              },
              "activatedSkills": { "$ref": "#/$defs/paths" },
              "delegatedAgents": { "$ref": "#/$defs/paths" }
            }
          }
        },
        "oneOf": [
          { "required": ["prompt"], "not": { "required": ["promptFile"] } },
          { "required": ["promptFile"], "not": { "required": ["prompt"] } }
        ]
      }
    }
  },
  "$defs": {
    "name": { "type": "string", "minLength": 1 },
    "paths": { "type": "array", "items": { "$ref": "#/$defs/name" } },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "reasoning", "version"],
      "properties": {
        "provider": { "const": "openai" },
        "model": { "$ref": "#/$defs/name" },
        "reasoning": { "$ref": "#/$defs/name" },
        "version": { "$ref": "#/$defs/name" },
        "executable": { "$ref": "#/$defs/name" }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "version"],
      "properties": {
        "sha": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "version": { "$ref": "#/$defs/name" }
      }
    }
  }
}
